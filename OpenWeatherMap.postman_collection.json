{
  "info": {
    "name": "OpenWeatherMap API Testing",
    "description": "API tests for the OpenWeatherMap Current Weather endpoint: 1 positive and 2 negative scenarios, 19 assertions.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "GET Current Weather - Cairo",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// ===== Happy Path: Get current weather for Cairo =====",
              "const json = pm.response.json();",
              "",
              "pm.test(\"Status code is 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test(\"Response time is less than 1500ms\", function () {",
              "    pm.expect(pm.response.responseTime).to.be.below(1500);",
              "});",
              "",
              "pm.test(\"Response is JSON\", function () {",
              "    pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/json\");",
              "});",
              "",
              "pm.test(\"City is Cairo and country is EG\", function () {",
              "    pm.expect(json.name).to.eql(\"Cairo\");",
              "    pm.expect(json.sys.country).to.eql(\"EG\");",
              "});",
              "",
              "pm.test(\"Response contains main weather fields\", function () {",
              "    pm.expect(json).to.have.property(\"main\");",
              "    pm.expect(json).to.have.property(\"weather\");",
              "    pm.expect(json).to.have.property(\"wind\");",
              "    pm.expect(json).to.have.property(\"coord\");",
              "});",
              "",
              "pm.test(\"Temperature and humidity are numbers\", function () {",
              "    pm.expect(json.main.temp).to.be.a(\"number\");",
              "    pm.expect(json.main.humidity).to.be.a(\"number\");",
              "});",
              "",
              "pm.test(\"Temperature is within a realistic range for Cairo\", function () {",
              "    pm.expect(json.main.temp).to.be.within(-5, 55);",
              "});",
              "",
              "pm.test(\"Humidity is between 0 and 100\", function () {",
              "    pm.expect(json.main.humidity).to.be.within(0, 100);",
              "});",
              "",
              "pm.test(\"Weather description is a non-empty string\", function () {",
              "    pm.expect(json.weather).to.be.an(\"array\").that.is.not.empty;",
              "    pm.expect(json.weather[0].description).to.be.a(\"string\").and.not.empty;",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/weather?q=Cairo,EG&appid={{apiKey}}&units=metric",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "weather"
          ],
          "query": [
            {
              "key": "q",
              "value": "Cairo,EG"
            },
            {
              "key": "appid",
              "value": "{{apiKey}}"
            },
            {
              "key": "units",
              "value": "metric"
            }
          ]
        }
      },
      "response": []
    },
    {
      "name": "GET Weather - Invalid City (404)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// ===== Negative Test: Invalid city name =====",
              "const json = pm.response.json();",
              "",
              "pm.test(\"Status code is 404 Not Found\", function () {",
              "    pm.response.to.have.status(404);",
              "});",
              "",
              "pm.test(\"Response time is less than 1500ms\", function () {",
              "    pm.expect(pm.response.responseTime).to.be.below(1500);",
              "});",
              "",
              "pm.test(\"Response body cod is '404'\", function () {",
              "    pm.expect(json.cod).to.eql(\"404\");",
              "});",
              "",
              "pm.test(\"Error message is 'city not found'\", function () {",
              "    pm.expect(json.message).to.eql(\"city not found\");",
              "});",
              "",
              "pm.test(\"No weather data is returned\", function () {",
              "    pm.expect(json).to.not.have.property(\"main\");",
              "    pm.expect(json).to.not.have.property(\"weather\");",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/weather?q=xyzCity123&appid={{apiKey}}&units=metric",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "weather"
          ],
          "query": [
            {
              "key": "q",
              "value": "xyzCity123"
            },
            {
              "key": "appid",
              "value": "{{apiKey}}"
            },
            {
              "key": "units",
              "value": "metric"
            }
          ]
        }
      },
      "response": []
    },
    {
      "name": "GET Weather - Unauthorized (401)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// ===== Negative Test: Invalid API key =====",
              "const json = pm.response.json();",
              "",
              "pm.test(\"Status code is 401 Unauthorized\", function () {",
              "    pm.response.to.have.status(401);",
              "});",
              "",
              "pm.test(\"Response time is less than 1500ms\", function () {",
              "    pm.expect(pm.response.responseTime).to.be.below(1500);",
              "});",
              "",
              "pm.test(\"Response body cod is 401\", function () {",
              "    pm.expect(json.cod).to.eql(401);",
              "});",
              "",
              "pm.test(\"Error message mentions invalid API key\", function () {",
              "    pm.expect(json.message.toLowerCase()).to.include(\"invalid api key\");",
              "});",
              "",
              "pm.test(\"No weather data is returned\", function () {",
              "    pm.expect(json).to.not.have.property(\"main\");",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/weather?q=Cairo,EG&appid=invalid_key_123&units=metric",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "weather"
          ],
          "query": [
            {
              "key": "q",
              "value": "Cairo,EG"
            },
            {
              "key": "appid",
              "value": "invalid_key_123"
            },
            {
              "key": "units",
              "value": "metric"
            }
          ]
        }
      },
      "response": []
    }
  ]
}